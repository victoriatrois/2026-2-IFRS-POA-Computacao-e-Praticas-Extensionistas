# Backend authentication settings
# Copy this file to .env and replace the placeholder values.
SPRING_PROFILES_ACTIVE=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Set these values only when creating the first administrator.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_SURNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_CPF=
BOOTSTRAP_ADMIN_PASSWORD=
